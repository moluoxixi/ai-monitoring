# Local Vue + NestJS notification center. The home page groups configuration and messages by AI client.
AIMONITOR_HOST=127.0.0.1
AIMONITOR_PORT=8787
# Desktop builds override these with read-only resources and a writable user-data directory.
AIMONITOR_RESOURCE_ROOT=
AIMONITOR_DATA_ROOT=
AIMONITOR_WEB_DIST_PATH=
AIMONITOR_OPENCLAW_CLI_PATH=
AIMONITOR_OPENCLAW_GATEWAY_PORT=18789
AIMONITOR_OPENCLAW_STATE_DIR=
AIMONITOR_OPENCLAW_VERSION=2026.7.1-2
AI_MONITOR_QQBOT_PLUGIN_VERSION=2.0.1
AI_MONITOR_WEIXIN_PLUGIN_VERSION=2.4.6
AIMONITOR_DB_PATH=data/monitor.db
AIMONITOR_OPENCLAW_BINDINGS_PATH=data/openclaw-channels.json
AIMONITOR_PUSHPLUS_BINDING_PATH=data/pushplus-binding.json
AIMONITOR_APPRISE_CHANNELS_PATH=data/apprise-channels.json
AIMONITOR_USER_SETTINGS_PATH=data/user-settings.json
# Short delay lets Codex notify/session sources merge the final answer before delivery.
AIMONITOR_ANSWER_CAPTURE_GRACE_MS=1500
# Recoverable stream/network failures are held until a follow-up turn can supersede them.
AIMONITOR_RECOVERABLE_FAILURE_GRACE_MS=600000
# Optional override. The server watches Codex structured session terminals to avoid notify gaps.
AIMONITOR_CODEX_SESSIONS_PATH=
# Optional Claude Desktop local-agent audit root override.
AIMONITOR_CLAUDE_DESKTOP_SESSIONS_PATH=
# Optional Hermes Desktop read-only state/request-dump overrides.
AIMONITOR_HERMES_STATE_PATH=
AIMONITOR_HERMES_SESSIONS_PATH=
# On startup, import structured Codex terminal events from this recent time window.
AIMONITOR_CODEX_BACKFILL_MINUTES=120
# Comma-separated advanced Apprise URLs. PushPlus is bound in the web interface.
AIMONITOR_APPRISE_URLS=
# Optional bearer token for local event producers.
AIMONITOR_INGEST_TOKEN=
AIMONITOR_RETRY_BASE_SECONDS=5
AIMONITOR_RETRY_MAX_SECONDS=3600

# Docker Compose host-side settings. docker-start.ps1 fills blank tokens automatically.
AIMONITOR_DOCKER_PORT=8787
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
# Host path mounted read-only at /codex-sessions. Windows paths should use forward slashes.
CODEX_SESSIONS_PATH=
