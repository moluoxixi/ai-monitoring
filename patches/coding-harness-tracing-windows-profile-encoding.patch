+def _profile_encoding(path: Path) -> str:
+    """Detect common shell profile encodings while preserving the original format."""
+    prefix = path.read_bytes()[:3]
+    if prefix.startswith((b"\xff\xfe", b"\xfe\xff")):
+        return "utf-16"
+    if prefix.startswith(b"\xef\xbb\xbf"):
+        return "utf-8-sig"
+    return "utf-8"
